# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB (used for tender data via MongoEngine)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=tender_trail
MONGO_USERNAME=
MONGO_PASSWORD=

# Email / Alert Engine (leave blank to simulate alerts on console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@tendertrail.local

# Scraper
SCRAPER_INTERVAL_HOURS=24
SCRAPER_THREAD_COUNT=4
